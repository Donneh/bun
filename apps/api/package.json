{
  "name": "@riftkeeper/api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "bun scripts/validate-snapshot.ts && wrangler deploy --dry-run --outdir dist",
    "test": "bun test src scripts",
    "test:api": "bun scripts/test-api.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "benchmark:v8": "bun build scripts/benchmark.ts --target node --outfile dist/benchmark.mjs && node dist/benchmark.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@riftkeeper/cards": "workspace:*",
    "@riftkeeper/search": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "4.154.0"
  }
}
