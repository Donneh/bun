{
  "name": "riftkeeper",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @riftkeeper/api dev",
    "dev:web": "bun run --filter @riftkeeper/web dev",
    "test:e2e": "bun run --filter @riftkeeper/web test:e2e",
    "scrape": "bun run --filter @riftkeeper/ingest scrape",
    "test": "bun run --filter \"*\" --sequential test && bun test ./infrastructure",
    "test:api": "bun run --filter @riftkeeper/api test:api",
    "benchmark": "bun run --filter @riftkeeper/api benchmark:v8",
    "typecheck": "bun run --filter \"*\" typecheck",
    "build": "bun run --filter \"*\" build",
    "deploy": "bun run --filter @riftkeeper/api build && bun run --filter @riftkeeper/web build && tofu -chdir=infrastructure apply",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check && bun run typecheck && bun run test && bun run test:api && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  }
}
