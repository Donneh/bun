{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!apps/api/data", "!apps/ingest/src/fixtures"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "html": { "experimentalFullSupportEnabled": true },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["apps/web/app/pages/**"],
      "linter": { "rules": { "style": { "useVueMultiWordComponentNames": "off" } } }
    },
    {
      "includes": ["packages/ui/src/SearchBar.vue"],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    }
  ]
}
